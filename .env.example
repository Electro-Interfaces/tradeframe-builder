# TradeControl - Frontend Environment Configuration
# Скопируйте файл в .env и заполните значения. Переменные с VITE_ попадают
# в браузерный бандл — никаких секретов сюда не клади.

# ===========================================
# DEV PROXY (vite dev server)
# ===========================================
# Куда vite проксирует /api/* в dev-режиме.
# Если не задано — http://localhost:3001 (нужен локальный backend).
# Чтобы работать БЕЗ локального backend, используй test-сервер:
# VITE_API_PROXY_TARGET=https://testtf.dataworker.ru

# ===========================================
# FALLBACK BACKEND URL (production build)
# ===========================================
# Используется, когда фронт собран статикой и не знает,
# где находится backend. Для local dev не нужно.
# VITE_FALLBACK_BACKEND_URL=https://testtf.dataworker.ru

# ===========================================
# NOTES
# ===========================================
# 1. Backend-секреты (DATABASE_URL, STS_*, MSTO_*, TradeCorp_*, JWT_SECRET и т.д.)
#    живут в server/.env, НЕ здесь. См. server/.env.example.
# 2. Переменные без префикса VITE_ из этого файла НЕ читаются фронтом.
# 3. Приоритет: .env.local > .env > .env.example
