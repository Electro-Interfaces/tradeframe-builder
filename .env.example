# TradeControl - Environment Configuration
# Копируйте этот файл в .env и заполните своими данными

# ===========================================
# SUPABASE (frontend, legacy fallback)
# ===========================================

VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ===========================================
# STS API (External Trading System)
# ===========================================

VITE_STS_API_URL=https://pos.autooplata.ru/tms
VITE_STS_API_USERNAME=UserApi
VITE_STS_API_PASSWORD=your_sts_password_here

# Backend-only STS (без VITE_ префикса)
STS_API_URL=https://pos.autooplata.ru/tms
STS_API_USERNAME=UserApi
STS_API_PASSWORD=your_sts_password_here

# ===========================================
# FRONTEND API MODE
# ===========================================
# backend = все запросы через Express proxy → PG
# supabase (или не задано) = прямые запросы в Supabase REST

VITE_AUTH_API_MODE=backend
VITE_ADMIN_API_MODE=backend
VITE_ORG_API_MODE=backend
VITE_AUDIT_API_MODE=backend
VITE_LEGAL_API_MODE=backend
VITE_NOMENCLATURE_API_MODE=backend

# ===========================================
# BACKEND SERVER
# ===========================================

PORT=3001
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ===========================================
# POSTGRESQL (primary data source)
# ===========================================

DATABASE_URL=postgresql://tradeframe:password@localhost:5432/tradeframe
AUTH_DATA_SOURCE=pg
DATA_SOURCE=pg
JWT_SECRET=change-me-in-production

# ===========================================
# SUPABASE (backend, legacy fallback)
# ===========================================

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your_service_role_key_here

# ===========================================
# TSUPPORT SDK
# ===========================================

TSUPPORT_API_URL=http://81.200.148.35:3080
TSUPPORT_SDK_API_KEY=your_api_key_here
TSUPPORT_SDK_SECRET=your_secret_here

# ===========================================
# MSTO API (IntegratorService)
# ===========================================

# MSTO_API_URL=http://46.229.214.21:3000
# MSTO_USERNAME=your_username
# MSTO_PASSWORD=your_password

# ===========================================
# TRADECORP API
# ===========================================

# TRADECORP_API_URL=https://api.autooplata.ru
# TRADECORP_LOGIN=your_login
# TRADECORP_PASSWORD=your_password
# TRADECORP_EMITENT_ID=15

# ===========================================
# TELEGRAM (notifications)
# ===========================================

# TELEGRAM_BOT_TOKEN=your_bot_token
# TELEGRAM_BOT_NAME=TradeFrame Notifications
# TELEGRAM_BOT_USERNAME=YourBot

# ===========================================
# NOTES
# ===========================================

# 1. Переменные с VITE_ попадают в браузерный бандл — НЕ ставить секреты
# 2. Service role key — ТОЛЬКО в server/.env (SUPABASE_SERVICE_KEY, без VITE_)
# 3. server/.env создаётся автоматически при CI/CD из GitHub Secrets
# 4. Приоритет: .env.local > .env > .env.example
