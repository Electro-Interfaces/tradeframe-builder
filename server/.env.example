# Backend Proxy Configuration
# Эти переменные НИКОГДА не попадут в frontend bundle
# Скопируйте в .env и заполните значения (получить у МАГа)

# STS API Configuration (External Trading System)
STS_API_URL=https://pos.autooplata.ru/tms
STS_API_USERNAME=
STS_API_PASSWORD=

# Backend Server Configuration
PORT=3001
NODE_ENV=development

# CORS Configuration (разрешенные домены для frontend)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# Telegram Bot Configuration
TELEGRAM_BOT_NAME=TradeFrame Notifications
TELEGRAM_BOT_USERNAME=TradeFrameDW_Bot

# TradeCorp API Configuration (Corporate Processing)
TRADECORP_API_URL=https://api.autooplata.ru
TRADECORP_EMPLOYEE_API_URL=https://api.invoicebox.vobrabotke.ru/api
TRADECORP_LOGIN=
TRADECORP_PASSWORD=
TRADECORP_EMITENT_ID=15

# Отключить автоматические уведомления для локальной разработки
DISABLE_NOTIFICATION_SCHEDULER=true

# MSTO IntegratorService API Configuration
MSTO_API_URL=http://46.229.214.21:3000
MSTO_USERNAME=
MSTO_PASSWORD=

# TSupport SDK Configuration
TSUPPORT_API_URL=http://81.200.148.35:3080
TSUPPORT_SDK_API_KEY=
TSUPPORT_SDK_SECRET=

# Единый шлюз intake заявок -> Plane SUP (зеркалирование заявок/сообщений в систему
# контроля заданий). Fire-and-forget: пустой секрет = канал отключён, TSupport не затронут.
SUPPORT_INTAKE_URL=https://events.dataworker.ru/api/intake/support
SUPPORT_INTAKE_SECRET=

# PostgreSQL
DATABASE_URL=postgresql://tradeframe:tradeframe_staging@localhost:5435/tradeframe

# JWT Secret (для dev можно любую строку)
JWT_SECRET=local-dev-secret-change-me

# TradeLink Hub API (раздел «Состояние станций» — IT-мониторинг АЗС)
# Доступ к Hub (PoC):
#   A) overlay-пир TradeLink на машине  → TRADELINK_HUB_URL=http://10.10.80.1:3100
#   B) ssh-туннель: ssh -L 3100:localhost:3100 tl-hub-new → TRADELINK_HUB_URL=http://localhost:3100
TRADELINK_HUB_URL=http://10.10.80.1:3100
TRADELINK_HUB_USERNAME=
TRADELINK_HUB_PASSWORD=
